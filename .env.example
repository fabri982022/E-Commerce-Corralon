# Copiar como ".env" y completar. El archivo ".env" NO se sube a Git.

DB_NAME=ferreteria
DB_USER=ferreteria_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

MYSQL_HOST_PORT=3308
ADMINER_PORT=8081
BACKEND_PORT=8080
FRONTEND_PORT=3000

JPA_DDL_AUTO=update
TZ=America/Argentina/Jujuy

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generar una clave con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# false para localhost sin HTTPS; usar true detrás de HTTPS en producción
AUTH_COOKIE_SECURE=false

# Cuentas iniciales: crear contraseñas aleatorias únicas y mantenerlas fuera de Git
SEED_USERS_ENABLED=true
SEED_ADMIN1_EMAIL=admin1@corralon.local
SEED_ADMIN1_PASSWORD=
SEED_ADMIN2_EMAIL=admin2@corralon.local
SEED_ADMIN2_PASSWORD=
SEED_CLIENT1_EMAIL=cliente1@corralon.local
SEED_CLIENT1_PASSWORD=
SEED_CLIENT2_EMAIL=cliente2@corralon.local
SEED_CLIENT2_PASSWORD=
