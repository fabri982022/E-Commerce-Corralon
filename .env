# Variables de Docker Compose. Archivo local: NO subir a Git.

# ---------- MySQL ----------
DB_NAME=ferreteria
DB_USER=ferreteria_user
DB_PASSWORD=alumno2008
DB_ROOT_PASSWORD=alumno2008

# ---------- Puertos en tu computadora ----------
MYSQL_HOST_PORT=3307
ADMINER_PORT=8081
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---------- Backend ----------
# update crea y ajusta las tablas (solo desarrollo)
JPA_DDL_AUTO=update
TZ=America/Argentina/Jujuy

# ---------- Cloudinary (completar con los datos de tu panel) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
